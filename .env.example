# Copy to .env.local and fill in. Never commit .env.local, and never put a
# real key in this file.

# Supabase Dashboard → Project Settings → API. Both are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional. Public URL of the app, used in email links. Defaults to the
# request origin, which is correct for local development.
# NEXT_PUBLIC_SITE_URL=https://ari.example.com

# Optional. Set to true only after enabling the Google provider in Supabase.
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Everything below is server-only. Never prefix any of it with NEXT_PUBLIC_:
# that would send it to the browser.
#
# Ari uses AI for two separate jobs, each chosen on its own:
#
#   AI generation   writes tutor answers, quiz questions and flashcards, and
#                   marks short answers
#   Embeddings      turns study materials into searchable passages
#
# To check the settings without opening the app, run:
#   npm run ai:check                   AI generation
#   npm run ai:check -- --embeddings   both

# --- AI generation -----------------------------------------------------------
#
# The student's question, the recent conversation and relevant passages from
# their materials are sent to the provider chosen here.
#
# Which provider to use: gemini, xai, anthropic or openai. Each provider reads
# only its own key and model below, so switching never sends one provider's
# key to another. If this is left out, anthropic is used.
AI_PROVIDER=gemini
#
# Optional. Longest tutor answer, in tokens (default 2000).
AI_MAX_OUTPUT_TOKENS=2000

# Gemini (AI_PROVIDER=gemini). A key from https://aistudio.google.com/apikey;
# it has a free tier.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash. A Flash model is recommended: it is
# quick, and Ari's tutoring, quizzes, flashcards and marking all work on it.
GEMINI_MODEL=

# Grok (AI_PROVIDER=xai). A key from https://console.x.ai. Optional: Ari does
# not need Grok unless it is the chosen provider.
XAI_API_KEY=
# Optional. Defaults to grok-4.7.
XAI_MODEL=

# Claude (AI_PROVIDER=anthropic). A key from https://console.anthropic.com.
# AI_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
# AI_MODEL=claude-sonnet-5-5

# Any OpenAI-compatible chat API (AI_PROVIDER=openai). Uses the same two
# variables as Claude, plus the API's address.
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_API_URL=https://api.openai.com/v1

# --- Embeddings --------------------------------------------------------------
#
# Required to process and search study materials. Without a working provider
# uploads still succeed and materials wait as "pending". Text from students'
# documents is sent to the provider chosen here.
#
# Which provider to use: openai or gemini. If this is left out, openai is used.
# Both produce 1536-dimension vectors, so the database is the same for either.
#
# Changing this later deletes nothing, but materials processed with one
# provider are not searchable with the other until you press "Reprocess" on
# them. Vectors from different models cannot be compared.
EMBEDDING_PROVIDER=gemini

# Gemini (EMBEDDING_PROVIDER=gemini). Free tier. Uses GEMINI_API_KEY above.
# Optional. Defaults to gemini-embedding-001.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI (EMBEDDING_PROVIDER=openai), or any OpenAI-compatible embeddings API.
# EMBEDDING_API_KEY=
# Optional. Defaults to text-embedding-3-small. The model must be able to
# return 1536-dimension vectors (see lib/ai/config.ts).
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_URL=https://api.openai.com/v1

# --- Tuning (all optional) ---------------------------------------------------
#
# Passages from the student's materials given to Ari per tutor question
# (default 6, maximum 12).
# TUTOR_TOP_K=6
#
# Passages given to Ari when writing a quiz or a flashcard deck (default 12,
# maximum 20).
# PRACTICE_MAX_CHUNKS=12

# Do NOT add the Supabase service-role key. This app never needs it.
